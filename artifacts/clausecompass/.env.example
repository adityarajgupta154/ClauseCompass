# ClauseCompass web app: the Firebase web config for sign-in (see /.env.example
# at the repo root, which documents the whole set). Vite reads VITE_* from the
# environment or from a .env file in this directory (.env is git-ignored).
# These values identify the Firebase project and ship in the browser bundle;
# they are not secrets. What they allow is set in the Firebase console.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# "mock" signs a made-up reader in without Firebase, for tests and the
# accessibility run only (the API must run with AUTH_PROVIDER=mock too).
# Refused by a production build.
# VITE_AUTH_PROVIDER=

# Where the header's "Give feedback" row leads (an https: form or a mailto:
# address). Without it the row is not shown.
# VITE_FEEDBACK_URL=

# The public address the app is served from (https://example.org; an https:
# address with no credentials, query or fragment, or the build stops). Read
# at build time: it fills the canonical link, og:url, the social image
# address, the structured data and the sitemap. Unset, those lines are left
# out (a preview build) and robots.txt names no sitemap; a published build
# on Replit falls back to REPLIT_DOMAINS.
# VITE_SITE_URL=

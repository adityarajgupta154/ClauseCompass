.env
.env.*
!.env.example


# ClauseCompass: this repo is public and must never contain a real document.
# samples/real/ is for local experiments only; attached/uploaded files are
# copied into docs/ or samples/ deliberately, never committed wholesale.
samples/real/
attached_assets/

# Replit conversation transfer data
.conversation/

# Keyboard + axe audit output (pnpm a11y)
scripts/a11y/report/

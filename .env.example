# ClauseCompass environment variables.
# Local runs: copy this file to .env at the repo root (.env is git-ignored; never commit it).
# Replit: set the same names as Secrets instead of using a file.
# The API server refuses to start, with a message naming the problem, when any of these is missing or malformed.

# Port the API server listens on. `pnpm dev` at the repo root sets this itself
# (API 8080, web 5173); only needed when running the API package on its own.
# Not read on Vercel, where the API runs as a function without a listener.
PORT=8080

# Anthropic API key, used server-side only (PRD section 7.3: a Haiku/Sonnet-class,
# schema-constrained model). The web client never sees this name or value;
# `pnpm check:client-secrets` fails if it ever appears in the client bundle.
# Alternative: provision the Replit Anthropic AI integration instead, which sets
# AI_INTEGRATIONS_ANTHROPIC_BASE_URL and AI_INTEGRATIONS_ANTHROPIC_API_KEY (same
# protocol, billed to Replit credits); the server uses those when this is unset.
ANTHROPIC_API_KEY=

# Model id for the plain-language step. Default claude-haiku-4-5 (cheap, fast,
# strong at structured output). Must be available at the base URL in use.
# LLM_MODEL=claude-haiku-4-5

# Base URL for the Anthropic Messages API when using your own key. Default
# https://api.anthropic.com; only change it for a compatible proxy.
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# How long an uploaded document and its analysis stay in the session store
# before auto-purge. Whole minutes, 1 to 1440. Default 30.
SESSION_TTL_MINUTES=30

# Where sessions live. "memory" (default): this process, for one server.
# "redis": a Redis database every instance of the API shares; required on
# Vercel (VERCEL=1), where each request may run on a different instance.
# See docs/deployment.md.
# SESSION_STORE=memory

# With SESSION_STORE=redis, how the database is reached: either its REST URL
# (https, Upstash) with SESSION_STORE_TOKEN, or its redis:// or rediss:// URL
# with the password in it (redis://default:password@host:port; no token).
# Unset, the names a host injects are read instead: KV_REST_API_URL +
# KV_REST_API_TOKEN (the Upstash integration on Vercel), UPSTASH_REDIS_REST_URL
# + UPSTASH_REDIS_REST_TOKEN (Upstash's console), then REDIS_URL (Redis Cloud
# on Vercel, most hosts). The database must be this app's own: the session
# cap counts its keys.
# SESSION_STORE_URL=
# SESSION_STORE_TOKEN=
# REDIS_URL=

# A plain redis:// URL (no TLS) to a host beyond this machine and its private
# network is refused at boot, because the database password and the owner
# uids would cross the network in the clear (the documents are sealed either
# way). "true" accepts that; prefer the database's rediss:// URL.
# SESSION_STORE_ALLOW_PLAINTEXT=false

# With SESSION_STORE=redis: 32 bytes, as 64 hex characters (openssl rand -hex 32)
# or base64. Every document and output is encrypted under it before it is
# written, so the database holds no readable text. Changing it makes every
# existing session unreadable, which is how to retire them all at once.
# SESSION_STORE_KEY=

# The upload cap in MB, 1 to 10 (default 10, the format's limit), for a host
# whose request bodies are smaller: Vercel refuses bodies over 4.5 MB, so set
# 4 there, with VITE_UPLOAD_MAX_MB below at the same number.
# UPLOAD_MAX_MB=10

# Model provider. "anthropic" (default) requires ANTHROPIC_API_KEY; "gemini"
# requires GEMINI_API_KEY. "mock" makes no model calls and exists only so the test
# suite runs offline; the server refuses to start with it when NODE_ENV=production or inside a published app
# (REPLIT_DEPLOYMENT=1 or VERCEL=1).
# LLM_PROVIDER=anthropic

# LLM_PROVIDER=gemini uses the Google Gemini API's generateContent, with the key
# server-side only. The default base URL is
# https://generativelanguage.googleapis.com/v1beta.
# Alternative: provision the Replit Gemini AI integration instead, which sets
# AI_INTEGRATIONS_GEMINI_BASE_URL and AI_INTEGRATIONS_GEMINI_API_KEY; the server
# uses those when GEMINI_API_KEY is unset, as for Anthropic.
# GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# How many model calls the process has in flight at once (1 to 64); further
# calls wait their turn. Default 8.
# LLM_MAX_CONCURRENT=8

# Per-client request budgets, as requests per minute per client address (a
# token bucket, so a quiet client may spend a minute's worth in a burst). The
# first covers every /api route, the second also charges uploads and the three
# analyses. 0 turns a budget off; the offline test suite does that. Defaults
# 600 and 60. Over budget, a request is answered 429 with Retry-After.
# RATE_LIMIT_PER_MINUTE=600
# RATE_LIMIT_HEAVY_PER_MINUTE=60

# Which forwarding headers to believe for the client address those budgets
# key on (Express's "trust proxy" setting). Unset or false: the socket peer is
# the client and X-Forwarded-For is ignored, so a client cannot pick a fresh
# budget by forging it; behind a proxy every reader then shares the proxy's
# one budget. A hop count (1-16) trusts that many proxies and charges the
# address the outermost of them appended; a comma-separated list of addresses
# or CIDRs (loopback, linklocal, uniquelocal accepted as names) trusts exactly
# those; true believes the header as sent and is right only behind an edge
# that rewrites it (Replit's does, and the artifact env sets true there; so
# does Vercel's).
# TRUST_PROXY=false

# Browser origins, comma-separated, that may call the API from another origin
# (scheme and host only, https unless localhost). Unset, no cross-origin access
# is granted at all: the web app is served from the same origin as /api, so it
# needs none. Only set this when a separately hosted front end must call the API.
# CORS_ORIGINS=https://app.example.org

# Sign-in (PRD §9: a document is opened for the reader who uploaded it and
# shown to nobody else). The web app signs the reader in with Firebase
# Authentication; the API accepts that project's ID tokens and binds every
# session to the reader who opened it. "firebase" (default) requires
# FIREBASE_PROJECT_ID. "mock" accepts `mock:<uid>` tokens and exists only so
# the test suite and the accessibility run work offline; the server refuses
# to start with it when NODE_ENV=production or inside a published app.
# AUTH_PROVIDER=firebase

# The Firebase project whose sign-in tokens the API accepts (Firebase console →
# Project settings → Project ID). Must match VITE_FIREBASE_PROJECT_ID below.
FIREBASE_PROJECT_ID=

# The web app's Firebase config (Firebase console → Project settings → Your
# apps → SDK setup and configuration). These identify the project and ship in
# the browser bundle; they are not secrets. What they allow is decided in the
# console: which sign-in methods are on (Google, Email/Password) and which
# domains may use them (Authentication → Settings → Authorized domains).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Web-side counterpart of AUTH_PROVIDER: "mock" signs a made-up reader in
# without Firebase (tokens `mock:<uid>`, accepted only by AUTH_PROVIDER=mock).
# Refused by a production build. Leave unset for real use.
# VITE_AUTH_PROVIDER=

# The upload cap the reader is told, in MB, 1 to 10 (default 10). Read at
# build time; set it to the API's UPLOAD_MAX_MB on a host with smaller request
# bodies (Vercel: 4), so the number shown is the number enforced.
# VITE_UPLOAD_MAX_MB=

# Where the header's "Give feedback" row leads (an https: form or a mailto:
# address). Read at build time; without it the row is not shown.
# VITE_FEEDBACK_URL=

# The public address the app is served from (https://example.org; an https:
# address with no credentials, query or fragment, or the build stops). Read
# at build time: it fills the canonical link, og:url, the social image
# address, the structured data and the sitemap. Unset, those lines are left
# out (a preview build) and robots.txt names no sitemap; a published build
# on Replit falls back to REPLIT_DOMAINS.
# VITE_SITE_URL=

# Log verbosity: fatal | error | warn | info (default) | debug | trace | silent.
# LOG_LEVEL=info
